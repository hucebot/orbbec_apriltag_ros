<CycloneDDS>
    <Domain>
        <General>
            <Interfaces>
                <NetworkInterface name="lo" priority="1" />
                <NetworkInterface name="enp0s31f6" priority="2" />
            </Interfaces>
            <MaxMessageSize>1400B</MaxMessageSize>
            <AllowMulticast>false</AllowMulticast>
        </General>
        <Discovery>
            <ParticipantIndex>auto</ParticipantIndex>
            <Peers>
                <Peer address="10.68.0.1" />
                <Peer address="localhost" />
                <Peer address="10.68.0.208" />
            </Peers>
            <MaxAutoParticipantIndex>99</MaxAutoParticipantIndex>
        </Discovery>
        <Internal>
            <Watermarks>
                <WhcHigh>2000kB</WhcHigh>
            </Watermarks>
        </Internal>
        <Tracing>
            <Verbosity>config</Verbosity>
            <OutputFile>${HOME}/.ros/log/cdds.log</OutputFile>
        </Tracing>
        <SharedMemory>
            <Enable>true</Enable>
            <LogLevel>info</LogLevel>
        </SharedMemory>
    </Domain>
</CycloneDDS>
